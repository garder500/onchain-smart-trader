# Database configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trading_bot

# EVM Node RPC Configuration
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/demo
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/demo
CHAIN_ID=1

# Paper Trading Capital & Risk Management
INITIAL_PAPER_BALANCE=1000.00
MIN_LIQUIDITY=10000.00
MAX_POSITION_PERCENT=0.10
MAX_OPEN_POSITIONS=5

# Execution Simulation Parameters (Basis points: 100 bps = 1%)
SLIPPAGE_BPS=50
TRADING_FEE_BPS=30

# Smart Wallet Filtering Thresholds
MIN_WALLET_SCORE=65.00
MIN_WALLET_TRADES=5

# HTTP API Server Configuration
HOST=0.0.0.0
PORT=3000

# Logging & Telemetry
RUST_LOG=info,onchain_smart_trader=debug
